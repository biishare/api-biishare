PORT=4000
NODE_ENV=development
DB_USER=
DB_PASS=

# Required in production. Use a long random secret and keep it stable between deploys.
AUTH_TOKEN_SECRET=change-me-use-at-least-32-random-characters
AUTH_TOKEN_EXPIRES_IN_SECONDS=604800

# Development defaults. In production set AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_NAME=biishare_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Production examples:
# Same site/subdomains: AUTH_COOKIE_DOMAIN=.example.com and AUTH_COOKIE_SAME_SITE=lax
# Different sites only if unavoidable: AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007
AUTH_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/profile
AUTH_CALLBACK_BASE_URL=http://localhost:4000
API_PUBLIC_BASE_URL=http://localhost:4000
CREATOR_AUTO_APPROVE_EMAILS=tonymarques116@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
